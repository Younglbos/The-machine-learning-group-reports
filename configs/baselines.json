{
  "seeds": [1, 2, 3],
  "complete_datasets": ["BBCSport", "BBC4view", "Caltech101-20", "NUS-WIDE"],
  "scenario_a": {
    "dataset": "Caltech101-20",
    "view_indices": [3, 4],
    "rate_definition": "fraction_of_samples_missing_exactly_one_view",
    "missing_rates": [0.2, 0.4, 0.6],
    "patterns": ["random", "single_view", "class_related"],
    "fill_methods": ["zero", "mean"]
  },
  "scenario_b": {
    "dataset": "NUS-WIDE",
    "batches": 10,
    "drift_batch": 5,
    "drift_conditions": ["none", "mean_shift", "view_noise"],
    "shift_std": 2.0,
    "noise_std": 1.0,
    "window_batches": 2,
    "pca_components_per_view": 16,
    "batch_time_budget_s": 30.0,
    "probe_samples": 96
  },
  "preprocessing": "per_view_minmax",
  "kmeans": {"n_init": 10, "max_iter": 300, "tol": 0.0001},
  "cpu_threads": 1,
  "silhouette_sample_size": 256,
  "result_dir": "results/baseline_v1"
}
